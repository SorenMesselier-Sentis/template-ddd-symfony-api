{
	frankenphp
	order mercure after encode
	order php_server before file_server
}

# Port-only address (no hostname) => matches ANY Host header, plain HTTP,
# no automatic HTTPS/ACME attempt. Matches the old nginx setup, which had
# no `server_name` and so was also a catch-all — this matters inside Docker
# Compose, where different callers reach this container under different
# names (host machine via "localhost", other containers like Prometheus via
# the service name "php"); a hostname-restricted site address would silently
# not route those requests to the app. Override SERVER_NAME with a real
# domain (no scheme) in a non-Docker production deployment to get Caddy's
# automatic HTTPS instead.
{$SERVER_NAME::80}

root * public/
encode zstd br gzip

log {
	output stdout
	format console
}

# Mercure hub, embedded directly in this FrankenPHP/Caddy process (the
# module ships built into the dunglas/frankenphp image — no separate
# container). Exposed at /.well-known/mercure; requests there are handled
# entirely by this Caddy module and never reach the PHP/Symfony kernel, so
# there's nothing to wire in security.yaml for it. See Shared/Domain/RealTime
# (publish side) and User's GetRealtimeSubscriberTokenController (private
# topic subscriber auth) for the app-level wiring. Default (in-memory) "local"
# transport — history/subscriptions don't survive a container restart; fine
# for dev/demo use. Switch to the "bolt" transport (via a `transport bolt
# <path>` directive) if you need updates to survive a restart.
route {
	mercure {
		publisher_jwt {$MERCURE_JWT_SECRET}
		subscriber_jwt {$MERCURE_JWT_SECRET}
	}
	php_server
}
