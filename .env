# ======================================================================
# App
# ======================================================================
APP_ENV=dev
APP_VERSION=unknown
APP_SECRET=change_me_in_production
DEFAULT_URI=http://localhost:8080

# ======================================================================
# HTTP / web server (FrankenPHP)
# ======================================================================
HTTP_PORT=8080

# CORS (comma-separated origins, or * for all)
CORS_ALLOWED_ORIGINS=

# Reverse proxy / load balancer trust (production). FrameworkBundle reads
# both of these itself via its own env-var defaults — no framework.yaml
# change needed. Leave both empty for local Docker Compose (no proxy in
# front, current behavior): Request::getClientIp() then returns the direct
# peer, which quietly breaks IP-keyed rate limiting (auth + API limiters)
# behind any real reverse proxy/LB/CDN.
# SYMFONY_TRUSTED_PROXIES: IP/CIDR of the proxy, or the special value
# "REMOTE_ADDR" to trust whoever connects directly (useful when the proxy's
# IP isn't static, e.g. a sidecar or managed ingress). Setting this alone is
# enough — Symfony falls back to trusting X-Forwarded-For/Port/Proto.
# SYMFONY_TRUSTED_HEADERS: optional, only needed to customize that default
# set (e.g. add x-forwarded-host, or restrict it further); comma-separated.
SYMFONY_TRUSTED_PROXIES=
SYMFONY_TRUSTED_HEADERS=

# PHP
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=30

# ======================================================================
# Database — PostgreSQL
# ======================================================================
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}?serverVersion=16&charset=utf8"

###> symfony/lock ###
# Distributed locking — PostgreSQL advisory locks (shared across all
# php/scheduler containers via the same database — required so
# DefaultSchedule stays safe if the scheduler is scaled to multiple
# replicas). Do not use "flock" here: it only coordinates processes on a
# single filesystem, not across containers/replicas.
LOCK_DSN="postgresql+advisory://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}"
###< symfony/lock ###

# ======================================================================
# Queue / messaging — RabbitMQ
# ======================================================================
RABBITMQ_USER=app
RABBITMQ_PASSWORD=change_me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DSN="amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:${RABBITMQ_PORT}/%2f"

###> outbox ###
# Retention (in days) for published outbox messages before they are purged
# by the daily scheduled cleanup task. Must be >= 1; lower values fall back
# to the default of 30 days at runtime and emit a warning log.
OUTBOX_RETENTION_DAYS=30
###< outbox ###

# ======================================================================
# Cache / rate limiting / scheduler state — Redis
# (see "Cache and scale-out (Redis)" in the README)
# ======================================================================
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_DSN="redis://:${REDIS_PASSWORD}@redis:${REDIS_PORT}"

# ======================================================================
# Auth — JWT
# ======================================================================
###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=some_path
JWT_PUBLIC_KEY=some_path
JWT_PASSPHRASE=change_me
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TTL=
###< lexik/jwt-authentication-bundle ###

# ======================================================================
# Object storage — S3-compatible (Document BC). Garage in Docker (dev/CI),
# Cloudflare R2 in staging/prod (see README "Production: Cloudflare R2")
# ======================================================================
S3_ACCESS_KEY=garageadmin
S3_SECRET_KEY=change_me_16_char_minimum
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_USE_SSL=false
S3_API_PORT=3900
S3_PRESIGNED_URL_TTL=3600

# ======================================================================
# Email
# ======================================================================
###> symfony/mailer ###
# Use mailpit:1025 inside Docker;
# localhost:1025 when running PHP on the host.
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=noreply@example.com
###< symfony/mailer ###

# ======================================================================
# Real-time push — Mercure
# ======================================================================
###> symfony/mercure-bundle ###
# Mercure hub is embedded in the "php" container's FrankenPHP/Caddy process
# (see docker/frankenphp/Caddyfile) — no separate container. MERCURE_URL is
# the internal publish URL (server-to-server, resolved via Docker DNS to the
# running "php" service — used by the web process, "consume" worker and
# "scheduler" worker alike); MERCURE_PUBLIC_URL is what browsers subscribe to.
MERCURE_JWT_SECRET=change_me_mercure_jwt_secret_32_chars_minimum
MERCURE_URL="http://php/.well-known/mercure"
MERCURE_PUBLIC_URL="http://localhost:${HTTP_PORT}/.well-known/mercure"
###< symfony/mercure-bundle ###

# ======================================================================
# Observability — metrics, dashboards, error tracking, tracing
# ======================================================================

# Prometheus
PROMETHEUS_PORT=9090
# Metrics storage: apcu (single-container only) or redis (default — required
# once "php" is scaled to more than one replica, otherwise each replica
# reports disjoint counters)
METRICS_STORAGE=redis
METRICS_REDIS_HOST=redis
METRICS_REDIS_PORT=${REDIS_PORT}
METRICS_REDIS_PASSWORD=${REDIS_PASSWORD}

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

###> sentry/sentry-symfony ###
# Error tracking (see config/packages/sentry.yaml). Empty = disabled, safe
# no-op — the SDK never makes a network call without a DSN. Only wired up
# in prod (config/packages/monolog.yaml's "sentry_exception"/"sentry_log"
# handlers); explicitly forced off in the test environment either way.
SENTRY_DSN=
###< sentry/sentry-symfony ###

# OpenTelemetry OTLP endpoint (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
