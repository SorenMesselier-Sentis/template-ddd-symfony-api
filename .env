APP_ENV=dev
APP_VERSION=unknown
APP_SECRET=change_me_in_production
DEFAULT_URI=http://localhost:8080

# PostgreSQL
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}?serverVersion=16&charset=utf8"

# RabbitMQ
RABBITMQ_USER=app
RABBITMQ_PASSWORD=change_me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DSN="amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:${RABBITMQ_PORT}/%2f"

# Prometheus
PROMETHEUS_PORT=9090
# Metrics storage: apcu (default, single-container) or redis (scale-out)
METRICS_STORAGE=apcu
# Used only when METRICS_STORAGE=redis
METRICS_REDIS_HOST=127.0.0.1
METRICS_REDIS_PORT=6379
# METRICS_REDIS_PASSWORD=

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# Nginx
NGINX_PORT=8080

# CORS (comma-separated origins, or * for all)
CORS_ALLOWED_ORIGINS=

# OpenTelemetry OTLP endpoint (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# PHP
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=30

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=some_path
JWT_PUBLIC_KEY=some_path
JWT_PASSPHRASE=change_me
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TTL=
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
# Use mailpit:1025 inside Docker; 
# localhost:1025 when running PHP on the host.
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=noreply@example.com
###< symfony/mailer ###

# S3-compatible object storage (RustFS in Docker)
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=change_me
S3_ENDPOINT=http://rustfs:9000
S3_USE_SSL=false
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
S3_PRESIGNED_URL_TTL=3600

###> outbox ###
# Retention (in days) for published outbox messages before they are purged
# by the daily scheduled cleanup task. Must be >= 1; lower values fall back
# to the default of 30 days at runtime and emit a warning log.
OUTBOX_RETENTION_DAYS=30
###< outbox ###
