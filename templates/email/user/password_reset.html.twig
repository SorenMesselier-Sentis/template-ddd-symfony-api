{% extends 'email/layout.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block content %}
    <h1 style="margin: 0 0 16px; font-size: 24px; color: #18181b;">Hello {{ firstName }}!</h1>
    <p style="margin: 0 0 16px;">You requested a password reset. Click the button below to set a new password.</p>
    <p style="margin: 0 0 16px;">
        <a href="{{ resetUrl }}" style="display: inline-block; padding: 12px 24px; background-color: #18181b; color: #ffffff; text-decoration: none; border-radius: 6px;">Reset password</a>
    </p>
    <p style="margin: 0; color: #71717a; font-size: 14px;">This link expires in 1 hour. If you did not request this, you can ignore this email.</p>
{% endblock %}
