<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd"
>
    <entity name="App\User\Domain\Entity\PasswordResetToken" table="password_reset_tokens">

        <id name="id" type="password_reset_token_id" column="id"/>

        <field name="userId" type="user_id" column="user_id" nullable="false"/>
        <field name="token" type="string" column="token" length="2048" nullable="false" unique="true"/>
        <field name="expiresAt" type="datetime_immutable" column="expires_at" nullable="false"/>
        <field name="revoked" type="boolean" column="revoked" nullable="false"/>
        <field name="createdAt" type="datetime_immutable" column="created_at" nullable="false"/>

    </entity>
</doctrine-mapping>
