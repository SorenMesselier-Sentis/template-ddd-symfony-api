<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd"
>
    <entity name="App\User\Domain\Entity\Consent" table="consents">

        <unique-constraints>
            <unique-constraint columns="user_id,type" name="uniq_consents_user_id_type"/>
        </unique-constraints>

        <id name="id" type="consent_id" column="id"/>

        <field name="userId" type="user_id" column="user_id" nullable="false"/>
        <field name="type" type="consent_type" column="type" length="30" nullable="false"/>
        <field name="version" type="string" column="version" length="50" nullable="false"/>
        <field name="givenAt" type="datetime_immutable" column="given_at" nullable="false"/>
        <field name="withdrawnAt" type="datetime_immutable" column="withdrawn_at" nullable="true"/>

    </entity>
</doctrine-mapping>
