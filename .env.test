# define your env variables for the test env here
APP_ENV=test
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
DATABASE_URL="postgresql://app:change_me@postgres:5432/app_test?serverVersion=16&charset=utf8"
METRICS_STORAGE=in_memory
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TTL=2592000
CORS_ALLOWED_ORIGINS=

# S3-compatible object storage (Garage in Docker)
S3_ACCESS_KEY=garageadmin
S3_SECRET_KEY=change_me_16_char_minimum
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_USE_SSL=false
S3_PRESIGNED_URL_TTL=3600
